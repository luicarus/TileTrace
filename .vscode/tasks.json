{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TileTrace: compile extension",
      "type": "process",
      "command": "npm",
      "windows": {"command": "npm.cmd"},
      "args": ["run", "compile"],
      "options": {"cwd": "${workspaceFolder}/extension"},
      "problemMatcher": "$tsc",
      "group": {"kind": "build", "isDefault": true}
    }
  ]
}
